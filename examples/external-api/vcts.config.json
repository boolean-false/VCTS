{
  "$schema": "../../tools/vcts.schema.json",
  "schemaVersion": 1,
  "kind": "mod",
  "outDir": "../../build/external-api",
  "dependencies": [
    {
      "id": "rail_core",
      "path": "../../build/railcore/content/rail_core",
      "version": "1.0.3",
      "apiVersions": {
        "api": 1
      }
    }
  ],
  "units": [
    {
      "tsconfig": "tsconfig.json",
      "packs": [
        {
          "id": "rail_client",
          "root": "src/rail_client",
          "dependencies": [
            "rail_core"
          ]
        }
      ],
      "scripts": [
        {
          "id": "rail_client:world",
          "kind": "world",
          "source": "src/rail_client/world.ts",
          "factory": "create"
        }
      ]
    }
  ],
  "assets": [
    {
      "from": "tests/start.lua",
      "to": "start.lua"
    }
  ],
  "test": {
    "script": "start.lua",
    "marker": "VCTS_EXTERNAL_PASS",
    "evidencePath": "worlds/external-api-test/probe.json"
  }
}

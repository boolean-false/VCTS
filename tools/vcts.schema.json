{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCTS project",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "outDir",
    "units"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "mod",
        "game"
      ]
    },
    "outDir": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "basePacks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tsconfig",
          "packs"
        ],
        "properties": {
          "tsconfig": {
            "type": "string"
          },
          "sourceMaps": {
            "type": "boolean"
          },
          "packs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "root"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{1,23}$"
                },
                "root": {
                  "type": "string"
                },
                "public": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "dependencies": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "manifest": {
                  "type": "object"
                },
                "scope": {
                  "const": "project",
                  "description": "Модули в корне приложения вместо пака контента. ID должен быть project."
                }
              },
              "additionalProperties": false
            }
          },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "source",
                "factory"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "factory": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "world",
                    "content",
                    "hud",
                    "block",
                    "item"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "generators": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "source",
                "factory"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "factory": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "world",
                    "content",
                    "hud",
                    "block",
                    "item"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "layouts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "source",
                "factory"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "factory": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "world",
                    "content",
                    "hud",
                    "block",
                    "item"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "scripts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "source",
                "factory"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "factory": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "world",
                    "content",
                    "hud",
                    "block",
                    "item"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "nativeModules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "source",
                "declaration"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "declaration": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "applications": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "source"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "start",
                    "client",
                    "module"
                  ]
                },
                "source": {
                  "type": "string"
                },
                "factory": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "description": "Пути файлов и папок относительно from, которые не входят в сборку. Шаблоны не поддерживаются."
          }
        },
        "additionalProperties": false
      }
    },
    "test": {
      "type": "object",
      "required": [
        "script",
        "marker",
        "evidencePath"
      ],
      "properties": {
        "script": {
          "type": "string"
        },
        "marker": {
          "type": "string"
        },
        "evidencePath": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "packOutDirs": {
      "type": "object",
      "description": "Optional pack ID → destination folder. Build/watch copy only that pack; test uses outDir only. Paths are relative to this config or absolute.",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "$comment": {
      "type": "string",
      "description": "Пояснение к настройкам проекта; не влияет на сборку."
    },
    "dependencies": {
      "type": "array",
      "description": "Готовые внешние контент-паки. vcts add настраивает импорты и редактор, сборка не копирует их в ваш пак.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "description": "Точная ожидаемая версия package.json."
          },
          "types": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Модуль → локальная .d.ts относительно конфига; для Lua-паков без типов."
          },
          "apiVersions": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number"
              ]
            },
            "description": "Модуль → ожидаемая версия контракта из types/vcts.json."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

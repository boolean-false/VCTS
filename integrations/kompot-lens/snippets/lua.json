{
  "Kompot: колонка": {
    "prefix": "kcol",
    "body": ["K.Column({$1}, function()", "\t$0", "end)"],
    "description": "K.Column: сначала свойства, затем дочерние элементы"
  },
  "Kompot: строка": {
    "prefix": "krow",
    "body": ["K.Row({$1}, function()", "\t$0", "end)"],
    "description": "K.Row: сначала свойства, затем дочерние элементы"
  },
  "Kompot: контейнер": {
    "prefix": "kbox",
    "body": ["K.Box({$1}, function()", "\t$0", "end)"],
    "description": "K.Box: сначала свойства, затем дочерние элементы"
  },
  "Kompot: текст": {
    "prefix": "ktext",
    "body": ["K.Text(\"${1:Текст}\")$0"],
    "description": "Текстовый элемент Kompot"
  },
  "Kompot: изображение": {
    "prefix": "kimage",
    "body": ["K.Image(\"${1:путь/к/текстуре}\", {size = ${2:32}})$0"],
    "description": "Изображение Kompot"
  },
  "Kompot: отступ": {
    "prefix": "kspacer",
    "body": ["K.Spacer(${1:8})$0"],
    "description": "Пустое пространство Kompot"
  },
  "Kompot: превью": {
    "prefix": "kpreview",
    "body": [
      "K.preview(\"${1:Имя}\", {width = ${2:360}, height = ${3:200}, theme = ${4:K.BASE_THEME}, group = \"${5:Компоненты}\"}, function()",
      "\t$0",
      "end)"
    ],
    "description": "Объявление превью: показывается в панели Kompot справа от кода"
  },
  "Kompot: компонент": {
    "prefix": "kcomponent",
    "body": [
      "local ${1:Name} = K.component(function(props)",
      "\tlocal ${2:state} = K.state(${3:0})",
      "\t$0",
      "end)"
    ],
    "description": "Компонент со своей областью: свои хуки, перезапускается отдельно"
  },
  "Kompot: модуль UI": {
    "prefix": "kmodule",
    "body": [
      "local K = require \"kompot:kompot\"",
      "local ${1:UI} = require \"${2|kompot:ui,kompot_material:material|}\"",
      "local M = K.M",
      "",
      "local ${3:Screen} = K.component(function(props)",
      "\t$0",
      "end)",
      "",
      "K.preview(\"$3\", {width = 400, height = 300, theme = $1.theme()}, function()",
      "\t$3({})",
      "end)",
      "",
      "return {$3 = $3}"
    ],
    "description": "Модуль экрана Kompot с дизайн-системой и превью"
  },
  "Kompot: состояние": {
    "prefix": "kstate",
    "body": ["local ${1:value} = K.state(${2:nil})"],
    "description": "Состояние компонента"
  },
  "Kompot: опрос обычного кода": {
    "prefix": "kpoll",
    "body": ["local ${1:value} = K.poll(function() return ${2:source.value} end)"],
    "description": "Значение нереактивного кода: область перестраивается при изменении"
  }
}
